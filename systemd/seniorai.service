[Unit]
Description=SeniorAI (voice assistant for elderly parents)
Documentation=https://github.com/bitosaur/SeniorAI
# This is a systemd USER unit — runs under the login user's session, so
# PipeWire / WirePlumber / XDG_RUNTIME_DIR are all already set up for us.
# Install with: scripts/install_linux.sh (enables via `systemctl --user`).
#
# Wait for the user's audio stack before we touch SDL / PortAudio.
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service wireplumber.service
# Allow restart loop, but fail permanently after 10 restarts within 2 min so
# a truly broken config (bad API key etc.) does not spin forever.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/seniorai
EnvironmentFile=%h/seniorai/.env
Environment=PYTHONUNBUFFERED=1
# Force SDL to go through the pipewire-pulse shim. Do NOT set
# SDL_AUDIODRIVER=alsa here — that bypasses PipeWire entirely, which
# defeats our WirePlumber default-sink routing.
Environment=SDL_AUDIODRIVER=pulseaudio
ExecStart=%h/seniorai/.venv/bin/python -m src.main
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
# User units bind to default.target, not multi-user.target.
WantedBy=default.target
