# Copy to .env and fill in. NEVER commit .env.
# On Linux production (user-service model): chmod 600 .env
# (File stays owned by your login user — the user-service runs under your
# login, so no chown needed.)

# ---- Gmail SMTP ----
GMAIL_USER=your.account@gmail.com
# 16-char app password (spaces OK, will be stripped). NOT your regular Gmail password.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_RECIPIENT=your.account@gmail.com

# ---- Gemini Vision API ----
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Camera ----
CAMERA_INDEX=0
CAMERA_WARMUP_FRAMES=10
CAMERA_RESOLUTION_WIDTH=1920
CAMERA_RESOLUTION_HEIGHT=1080
CAMERA_JPEG_QUALITY=92

# ---- Buttons ----
# Values: pynput Key names (f1, f2, esc, ...), single chars (a, b, c, ...),
# or multimedia key names (copy, paste, cut).
#
# Dev (Windows/Mac keyboard):                f1 / f2 / f3
# Tested production keypad (USB 514c:8851):  c / v / x
#   — it emits Ctrl+C / Ctrl+V / Ctrl+X for "copy / paste / cut" buttons,
#     so we bind to the letter codes and let the Ctrl modifier be ignored.
#
# NOTE: other vendors' copy/paste/cut keypads may emit real KEY_COPY /
# KEY_PASTE / KEY_CUT events — use copy/paste/cut for those.
BUTTON_CHAT=f1
BUTTON_VISION=f2
BUTTON_TELEGRAM=f3

# Chat mode timing
CHAT_IDLE_TIMEOUT_SEC=150
MEDICINE_CHAT_WINDOW_SEC=30

# After a document is detected, how long to wait for the user to press F1
# and answer "read / send" before re-prompting, and how many times to ask.
# After all attempts, the photo silently seeds a chat session with "What's
# this?" so the user can still ask about it with F1.
DOCUMENT_PROMPT_TIMEOUT_SEC=30
DOCUMENT_PROMPT_MAX_ATTEMPTS=2

# ---- Microphone + voice activity detection ----
# Input device index (blank = system default). List via: python scripts/test_mic.py --list
MIC_DEVICE_INDEX=
MIC_SAMPLE_RATE=16000
# RMS energy (0.0-1.0) above which a 50ms block counts as speech.
# Quiet room ~0.003, normal speech ~0.02-0.1. Tune with test_mic.py.
VAD_ENERGY_THRESHOLD=0.01
# Silence duration that ends an utterance (seconds).
VAD_SILENCE_SEC=1.2
# How long to wait for speech to start before giving up this listen cycle.
VAD_MAX_WAIT_SEC=30
# Hard cap on a single utterance (seconds).
VAD_MAX_UTTERANCE_SEC=30

# ---- Input backend override (auto | pynput | evdev) ----
# auto = pynput on Windows, evdev on Linux
INPUT_BACKEND=auto
# Only used by evdev backend. Leave empty to auto-detect keyboard device.
# On the production NUC with our udev rule installed, set this to the
# stable ASCII symlink (avoids the Unicode-ridden /dev/input/by-id path):
#   EVDEV_DEVICE=/dev/input/seniorai-keypad
EVDEV_DEVICE=

# ---- Storage ----
CAPTURE_DIR=./captures
LOG_DIR=./logs
LOG_LEVEL=INFO

# ---- Google Cloud Text-to-Speech ----
# 1. Enable the API: https://console.cloud.google.com/apis/library/texttospeech.googleapis.com
# 2. Create an API key: https://console.cloud.google.com/apis/credentials
# 3. (Recommended) Restrict the key to the Cloud Text-to-Speech API only.
# Can be the same key as GEMINI_API_KEY if that key isn't API-restricted,
# but a separate key is cleaner.
GOOGLE_TTS_API_KEY=

# Default language if Gemini cannot detect. ISO 639-1 code.
TTS_DEFAULT_LANG=en
# Slow speech (true/false) — maps to speaking_rate 0.85 vs 1.0
TTS_SLOW=false

# ---- Network monitor ----
# How often to probe network status (seconds)
NETWORK_CHECK_INTERVAL_SEC=30
# How often to re-announce an ongoing outage (minutes)
NETWORK_REMINDER_INTERVAL_MIN=60
# Internet-reachability probe. Must return 2xx/204 when online.
NETWORK_CHECK_URL=http://connectivitycheck.gstatic.com/generate_204
NETWORK_CHECK_TIMEOUT_SEC=5
# Quiet hours: no audio alerts while the hour is in [start, end).
# start=22, end=7 means quiet from 10 PM to 6:59 AM (wraps midnight).
# Set start==end to disable quiet hours.
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# ---- Telegram ----
# Bot token from @BotFather on Telegram (message /newbot, save the token).
# This single bot handles BOTH admin alerts (errors to you) and the
# parents<->Gulu two-way chat via Button 3.
TELEGRAM_BOT_TOKEN=

# Admin chat ID: the chat that receives system error alerts. Message
# your new bot from your own account, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy the numeric "chat":{"id": ...}. Leave blank to disable alerts.
TELEGRAM_ADMIN_CHAT_ID=

# Gulu chat ID: the whitelisted family member the parents exchange
# voice messages with. Same lookup method as above, but have Gulu
# message the bot. Only messages from this chat_id are accepted.
# Leave blank to disable the send/receive flow (Button 3 becomes a no-op).
TELEGRAM_GULU_CHAT_ID=

# How often to re-announce "new message from Gulu" if the parents
# haven't pressed F3 yet (minutes). Quiet hours suppress the reminder.
TELEGRAM_UNREAD_REMINDER_MIN=60

# ===========================================================================
# Linux production overrides — copy these on top of the defaults above when
# deploying to the NUC (Debian 12 / PipeWire / user-service). Leave commented
# out during dev on Windows.
# ===========================================================================
#
# INPUT_BACKEND=evdev
# EVDEV_DEVICE=/dev/input/seniorai-keypad    # stable symlink from udev rule
# BUTTON_CHAT=c                                 # keypad "copy" = Ctrl+C
# BUTTON_VISION=v                               # keypad "paste" = Ctrl+V
# BUTTON_TELEGRAM=x                             # keypad "cut" = Ctrl+X
# MIC_DEVICE_INDEX=                             # empty = PipeWire default
# CAMERA_INDEX=0                                # Sunplus SPCA2281 at /dev/video0
